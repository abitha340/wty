# Neon DB PostgreSQL Connection String
# Get your free Neon DB connection string from https://console.neon.tech
# Example: postgresql://neondb_owner:password@ep-cool-cloud-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Fallback: if DATABASE_URL is empty or cannot connect, the backend automatically uses SQLite
ENVIRONMENT=development
PORT=8000
DEFAULT_USER_EMAIL=dev@wyt.io
